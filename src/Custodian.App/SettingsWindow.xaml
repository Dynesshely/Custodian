<Window x:Class="Custodian.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="880" Height="600"
        MinWidth="760" MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{DynamicResource AppFontFamily}"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <!-- 分段选择（主题 / 卡片视图）：选中态用层填充，未选中透明 -->
        <Style x:Key="SegmentStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Bg"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource LayerFillSelectedBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮（浏览 / 应用 / 恢复默认） -->
        <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bg"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource ControlFillBrush}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource FilterTextBoxStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextStyleSection}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="GroupTitleStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextStyleBodyStrong}">
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>

        <Style x:Key="GroupHintStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextStyleHint}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource WindowOutlineBrush}"
            Background="{DynamicResource BackdropBaseBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="18,0,10,0" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="TitleIcon" Width="18" Height="18" Margin="0,0,10,0" />
                    <TextBlock Text="设置" Style="{DynamicResource TextStyleBodyStrong}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Style="{DynamicResource IconButtonStyle}"
                        HorizontalAlignment="Right"
                        Click="OnCloseClick"
                        AutomationProperties.Name="关闭设置">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                </Button>
            </Grid>

            <!-- 左 Tabs + 右内容 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        BorderThickness="0,1,1,0"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        Padding="10,10,10,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <RadioButton x:Name="TabAppearance"
                                         Style="{DynamicResource RailItemStyle}"
                                         GroupName="SettingsTabs"
                                         IsChecked="True"
                                         Checked="OnTabChecked"
                                         Tag="appearance">
                                <TextBlock Text="外观" />
                            </RadioButton>
                            <RadioButton x:Name="TabSandbox"
                                         Style="{DynamicResource RailItemStyle}"
                                         GroupName="SettingsTabs"
                                         Checked="OnTabChecked"
                                         Tag="sandbox">
                                <TextBlock Text="沙盒" />
                            </RadioButton>
                        </StackPanel>

                        <TextBlock x:Name="StorageHint"
                                   Grid.Row="2"
                                   Style="{DynamicResource TextStyleHint}"
                                   Margin="8,0,4,0"
                                   TextWrapping="Wrap"
                                   LineHeight="16" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1"
                              Style="{DynamicResource ScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="26,20,22,24">
                    <Grid>
                        <!-- 外观 -->
                        <StackPanel x:Name="AppearancePanel">
                            <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />

                            <TextBlock Text="主题" Style="{StaticResource GroupTitleStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeSystem" Tag="system" Content="跟随系统"
                                             Style="{StaticResource SegmentStyle}" Checked="OnThemeChecked" />
                                <RadioButton x:Name="ThemeLight" Tag="light" Content="浅色"
                                             Style="{StaticResource SegmentStyle}" Checked="OnThemeChecked" />
                                <RadioButton x:Name="ThemeDark" Tag="dark" Content="深色"
                                             Style="{StaticResource SegmentStyle}" Checked="OnThemeChecked" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource GroupHintStyle}"
                                       Text="跟随系统时，Windows 切换深色 / 浅色，面板会同步切换。" />

                            <TextBlock Text="卡片视图" Style="{StaticResource GroupTitleStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ViewStandard" Tag="standard" Content="标准"
                                             Style="{StaticResource SegmentStyle}" Checked="OnViewChecked" />
                                <RadioButton x:Name="ViewCompact" Tag="compact" Content="紧凑"
                                             Style="{StaticResource SegmentStyle}" Checked="OnViewChecked" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource GroupHintStyle}"
                                       Text="标准视图：图标在左、名称与路径在右；紧凑视图：96×96 网格，标准应用程序收进文件夹块。也可以用 Ctrl+Shift+V 随时切换。" />
                        </StackPanel>

                        <!-- 沙盒 -->
                        <StackPanel x:Name="SandboxPanel" Visibility="Collapsed">
                            <TextBlock Text="沙盒存储位置" Style="{StaticResource SectionTitleStyle}" />

                            <TextBlock Text="当前生效" Style="{StaticResource GroupTitleStyle}" />
                            <Border Background="{DynamicResource ControlFillBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10">
                                <StackPanel>
                                    <TextBlock x:Name="EffectiveRootText"
                                               Style="{DynamicResource TextStyleBody}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="EffectiveRootSourceText"
                                               Style="{DynamicResource TextStyleHint}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="自定义位置" Style="{StaticResource GroupTitleStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SandboxRootBox"
                                         Grid.Column="0"
                                         Style="{StaticResource SettingsTextBoxStyle}"
                                         VerticalContentAlignment="Center"
                                         KeyDown="OnSandboxRootKeyDown" />
                                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OnBrowseSandboxRoot" />
                                <Button x:Name="ApplySandboxRootButton" Grid.Column="2" Content="应用"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OnApplySandboxRoot" />
                                <Button Grid.Column="3" Content="恢复默认" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OnResetSandboxRoot" />
                            </Grid>
                            <TextBlock x:Name="SandboxRootHint"
                                       Style="{StaticResource GroupHintStyle}"
                                       Text="这是 Sandboxie 的 FileRootPath 模板，可包含 %SANDBOX%、%USER%、%SESSION%、%SID%。留空表示跟随 Sandboxie.ini；保存后会重新扫描沙盒。" />

                            <TextBlock x:Name="SandboxIniPathText"
                                       Style="{StaticResource GroupHintStyle}"
                                       Margin="0,14,0,0" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
